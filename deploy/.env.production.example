# ========================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Alfalah Community Support Centre (Charity #1150221)
# ========================================================
# On your VPS, copy this file to: .env
#   cp deploy/.env.production.example .env
#
# Generate secure random keys with: openssl rand -base64 48
# ========================================================

NODE_ENV=production
PORT_BACKEND=4000
PORT_FRONTEND=3000

# ========================================================
# DOMAIN & URL CONFIGURATION
# ========================================================
# Set to your live domain with HTTPS
DOMAIN=alfalahcsc.com
NEXT_PUBLIC_SITE_URL=https://alfalahcsc.com
NEXT_PUBLIC_API_URL=https://alfalahcsc.com/api/v1
NEXT_PUBLIC_MEDIA_URL=https://alfalahcsc.com/uploads
CORS_ORIGIN=https://alfalahcsc.com

# ========================================================
# DATABASE (MySQL 8.4)
# ========================================================
DB_HOST=db
DB_PORT=3306
DB_NAME=alfalah_db
DB_USERNAME=alfalah_user
# Use a strong password generated specifically for production
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_2026
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD_2026
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ========================================================
# AUTHENTICATION & SECURITY
# ========================================================
# Run: openssl rand -base64 48
JWT_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_KEY_HERE
JWT_EXPIRATION=7d
COOKIE_SECRET=GENERATE_64_CHAR_RANDOM_COOKIE_SECRET_HERE
SESSION_COOKIE_NAME=alfalah_session

# Initial Super Admin (only used during first seed)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_2026!
INITIAL_ADMIN_NAME="Alfalah Admin"

# ========================================================
# STRIPE PAYMENTS (Donation Checkout & Webhook)
# ========================================================
# Obtain these from https://dashboard.stripe.com/apikeys
# Use Live keys (pk_live_... / sk_live_...) for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
# From https://dashboard.stripe.com/webhooks (Endpoint: https://yourdomain.com/api/donations/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# ========================================================
# EMAIL (SMTP for Contact Form & Notifications)
# ========================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Alfalah Community Support Centre <no-reply@yourdomain.com>"
CONTACT_NOTIFICATION_EMAIL=alfalahcsc@hotmail.com

# ========================================================
# MEDIA STORAGE
# ========================================================
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=/app/uploads
MEDIA_MAX_FILE_SIZE_BYTES=20971520
