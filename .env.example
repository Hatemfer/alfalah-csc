# ========================================================
# ALFALAH COMMUNITY SUPPORT CENTRE - MONOREPO ENVIRONMENT
# ========================================================
# Copy this file to .env, backend/.env, and frontend/.env.local as needed.
# NEVER commit real credentials or production secrets to git.

# Environment Mode
NODE_ENV=development
PORT_BACKEND=4000
PORT_FRONTEND=3000

# Backend / API Configuration
API_PREFIX=/api/v1
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=alfalah_user
DB_PASSWORD=alfalah_dev_2026
DB_NAME=alfalah_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Authentication & Security
# Generate secure 64+ char random keys for production: openssl rand -base64 48
JWT_SECRET=alfalah_development_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRATION=7d
COOKIE_SECRET=alfalah_development_cookie_secret_key_change_in_production_2026
SESSION_COOKIE_NAME=alfalah_session

# Initial Super Admin Provisioning (used only by npm run db:seed for local dev)
INITIAL_ADMIN_EMAIL=admin@alfalahcsc.com
INITIAL_ADMIN_PASSWORD=AlfalahAdmin2026!
INITIAL_ADMIN_NAME="Admin Alfalah"

# Media Storage Configuration
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE_BYTES=10485760
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000/uploads

# Prayer Times Default Configuration (Birmingham, UK)
DEFAULT_LATITUDE=52.4578
DEFAULT_LONGITUDE=-1.8904
DEFAULT_TIMEZONE=Europe/London
PRAYER_CALCULATION_METHOD=BirminghamUnified

# Email Provider Configuration (local test mock or SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASSWORD=mock_password
SMTP_FROM="Alfalah CSC <no-reply@alfalahcsc.com>"
CONTACT_NOTIFICATION_EMAIL=alfalahcsc@hotmail.com

# Organisation Constants (Read-only reference)
ORG_NAME_EN="ALFALAH COMMUNITY SUPPORT CENTRE"
ORG_NAME_AR="مركز الفلاح الإسلامي"
ORG_CHARITY_NUMBER="1150221"
ORG_ADDRESS="89 Tindal Street, Balsall Heath, Birmingham, B12 9QU, United Kingdom"
ORG_EMAIL="alfalahcsc@hotmail.com"
